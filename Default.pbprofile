{
  "Version": "1.0",
  "Name": "Default",
  "LocalhostViaProxy": false,
  "IsTrafficLoggingEnabled": false,
  "AutoClearConnectionLogs": true,
  "Language": "zh",
  "CloseToTray": false,
  "ProxyConfigs": [
    {
      "Id": 1,
      "Type": "SOCKS5",
      "Host": "127.0.0.1",
      "Port": "10808",
      "Username": "",
      "Password": ""
    },
    {
      "Id": 2,
      "Type": "HTTP",
      "Host": "127.0.0.1",
      "Port": "8089",
      "Username": "",
      "Password": ""
    }
  ],
  "ProxyRules": [
    {
      "ProcessName": "Antigravity.exe; language_server_windows_x64.exe; Antigravity IDE.exe; language_server.exe; agy.exe; node.exe; git.exe; ssh.exe; git-remote-https.exe; git-remote-http.exe",
      "TargetHosts": "*",
      "TargetPorts": "*",
      "Protocol": "BOTH",
      "Action": "PROXY",
      "IsEnabled": true,
      "ProxyConfigId": 1
    },
    {
      "ProcessName": "Figma.exe; figma_agent.exe",
      "TargetHosts": "*",
      "TargetPorts": "443",
      "Protocol": "UDP",
      "Action": "BLOCK",
      "IsEnabled": true,
      "ProxyConfigId": 0
    },
    {
      "ProcessName": "Figma.exe; figma_agent.exe",
      "TargetHosts": "*",
      "TargetPorts": "*",
      "Protocol": "TCP",
      "Action": "PROXY",
      "IsEnabled": true,
      "ProxyConfigId": 2
    }
  ],
  "LogFilters": []
}